# JumpServer Core Settings
SECRET_KEY=REPLACE_THIS_WITH_A_RANDOM_SECRET_KEY
BOOTSTRAP_TOKEN=REPLACE_THIS_WITH_A_SECURE_TOKEN
DEBUG=false
LOG_LEVEL=INFO

# MySQL Database Settings
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=jumpserver
MYSQL_PASSWORD=jumpserverpass
MYSQL_DATABASE=jumpserver
MYSQL_ROOT_PASSWORD=rootpass

# Redis Settings
REDIS_HOST=redis
REDIS_PORT=6379

# JumpServer Version
JUMPSERVER_VERSION=latest
